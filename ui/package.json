{
  "scripts": {
    "shadow:watch": "shadow-cljs watch app",
    "shadow:release": "shadow-cljs release app",
    "shadow:dev": "shadow-cljs watch app",
    "postcss:build": "cross-env postcss src/css/tailwind.css -o ./public/css/main.css --verbose",
    "postcss:watch": "cross-env postcss src/css/tailwind.css -o ./public/css/main.css --verbose -w",
    "postcss:dev": "cross-env postcss src/css/tailwind.css -o ./public/css/main.css --verbose",
    "postcss:release": "cross-env NODE_ENV=production postcss src/css/tailwind.css -o ./public/css/main.css --verbose",
    "dev": "run-p -l *:dev",
    "watch": "run-p -l *:watch",
    "release": "run-s *:release"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "autoprefixer": "^10.4.12",
    "clsx": "^2.1.0",
    "cssnano": "^6.0.0",
    "imask": "^7.4.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.23",
    "postcss-cli": "^10.1.0",
    "process": "^0.11.10",
    "scheduler": "^0.23.0",
    "shadow-cljs": "^2.27.4",
    "tailwindcss": "^3.3.2"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "create-react-class": "15.7.0",
    "cross-env": "^7.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}